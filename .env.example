# SafeRoute Saheli Environment Configuration
# Copy this file to .env and replace placeholder values.
# NEVER commit .env to version control!

# ============================================================================
# Core Flask & Security
# ============================================================================
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
JWT_SECRET=change_this_jwt_secret_to_another_secure_key_32_bytes_min
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30
TEST_MODE=true

# ============================================================================
# Database Configuration (MySQL / MariaDB)
# ============================================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=saferoute_saheli
MYSQL_USER=saheli_user
MYSQL_PASSWORD=saheli_password
# SQLite Fallback for local quick testing if MySQL is offline:
DATABASE_URL=mysql+pymysql://saheli_user:saheli_password@127.0.0.1:3306/saferoute_saheli

# ============================================================================
# Redis & Celery Cache / PubSub
# ============================================================================
REDIS_URL=redis://127.0.0.1:6379/0

# ============================================================================
# Firebase Admin SDK Credentials (Push Notifications & Storage)
# ============================================================================
FIREBASE_CREDENTIALS_PATH=backend/config/firebase-service-account.json
FIREBASE_PROJECT_ID=saferoute-saheli-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@saferoute-saheli-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ============================================================================
# SMS Alert Provider (Twilio / Exotel / Mock)
# ============================================================================
SMS_PROVIDER=MockSMSProvider
SMS_API_KEY=mock_sms_api_key
SMS_API_SECRET=mock_sms_api_secret
SMS_SENDER_ID=SAHELI

# ============================================================================
# Voice Emergency Call Provider (TwilioVoice / Exotel / Mock)
# ============================================================================
VOICE_PROVIDER=MockVoiceProvider
VOICE_API_KEY=mock_voice_api_key
VOICE_API_SECRET=mock_voice_api_secret
VOICE_CALLER_NUMBER=+18005550199

# ============================================================================
# Map & Geospatial Routing Providers
# ============================================================================
MAP_PROVIDER=OpenStreetMap
MAP_API_KEY=mock_openrouteservice_or_mapbox_key

# ============================================================================
# Media & Evidence Object Storage (Local / AWS S3 / Firebase)
# ============================================================================
STORAGE_PROVIDER=local
STORAGE_BUCKET=saferoute-evidence-store
STORAGE_ACCESS_KEY=local_minio_or_s3_key
STORAGE_SECRET_KEY=local_minio_or_s3_secret
UPLOAD_FOLDER=backend/uploads

# ============================================================================
# Hardware Security & Streaming Secrets
# ============================================================================
CAMERA_STREAM_SECRET=esp32cam_hmac_secret_token_saheli_2026
DEVICE_SECRET=wearable_esp32_hmac_shared_secret_2026
SESSION_TOKEN_SALT=salt_for_expiring_live_tracking_links_9918

# ============================================================================
# AI / ML Model Weights Path
# ============================================================================
AI_MODEL_PATH=ai_ml/models/weights/neuro_fuzzy_safety.pt
GENETIC_POPULATION_SIZE=50
GENETIC_MAX_GENERATIONS=40
